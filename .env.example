PORT=5000
# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/access_control_db

# For MongoDB Atlas:
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas cluster credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/access_control_db?retryWrites=true&w=majority

# Atlas Setup Checklist:
# 1. In Atlas -> Database Access: Create a database user with Read/Write privileges.
# 2. In Atlas -> Network Access: Add your current IP address (or 0.0.0.0/0 for anywhere).
# 3. If your password contains special characters (e.g. @, :, /, #), URL-encode them.

